# Builds the Mac app (Marquee.dmg) on GitHub's Macs — no Xcode needed on your own Mac.
# Open the Actions tab, pick "Build Mac app" and press "Run workflow". The finished app appears under
# "Artifacts" at the bottom of the run. It works on both Apple-chip (M1 and newer) and Intel Macs.
name: Build Mac app

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4

      - name: Pick Xcode
        run: sudo xcode-select -s "$(ls -d /Applications/Xcode_16*.app | sort -V | tail -1)" && xcodebuild -version

      - name: Make the Xcode project
        run: |
          brew install xcodegen
          xcodegen generate

      - name: Build
        run: |
          set -o pipefail
          xcodebuild -project Marquee.xcodeproj -scheme MarqueeMac -configuration Release \
            -destination 'generic/platform=macOS' -derivedDataPath build \
            ARCHS="arm64 x86_64" ONLY_ACTIVE_ARCH=NO build | tee build-mac.log | grep -E "error:|BUILD (SUCCEEDED|FAILED)" || true
          test -d build/Build/Products/Release/Marquee.app || { grep -B5 -A20 "error:" build-mac.log | head -150; exit 1; }

      - name: Package as a disk image
        run: |
          APP=build/Build/Products/Release/Marquee.app
          codesign --force --deep -s - "$APP"
          mkdir dmg && cp -R "$APP" dmg/ && ln -s /Applications dmg/Applications
          lipo -archs "$APP/Contents/MacOS/Marquee"
          # GitHub's Macs occasionally report "Resource busy" on the first try
          for i in 1 2 3; do hdiutil create -volname "Marquee" -srcfolder dmg -ov -format UDZO Marquee.dmg && break || sleep 5; done
          ls -la Marquee.dmg

      - uses: actions/upload-artifact@v4
        with:
          name: Marquee-Mac
          path: Marquee.dmg
